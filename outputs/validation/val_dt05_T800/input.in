units metal
dimension 3
boundary p p p
atom_style atomic
read_restart outputs/validation/val_dt05_T800/equilibrated.restart
mass 1 63.546
pair_style eam/alloy
pair_coeff * * potentials/Cu01.eam.alloy Cu
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 0.0005
fix integrator all npt temp 800 800 0.1 iso 0 0 1
variable clock equal time
variable temperature equal temp
variable pressure equal press
variable potential_energy equal pe
variable length_x equal lx
variable length_y equal ly
variable length_z equal lz
variable volume equal vol
thermo 1000
thermo_style custom step time atoms temp press pe etotal lx ly lz vol
thermo_modify format float %.12g flush yes
fix scalars all ave/time 200 1 200 v_clock v_temperature v_pressure v_potential_energy v_length_x v_length_y v_length_z v_volume append outputs/validation/val_dt05_T800/thermo.dat start 400200 format " %.12g"
dump frames all custom 200000 outputs/validation/val_dt05_T800/trajectory.lammpstrj id type x y z
dump_modify frames sort id
run 1000000
write_data outputs/validation/val_dt05_T800/final.data
write_restart outputs/validation/val_dt05_T800/final.restart
